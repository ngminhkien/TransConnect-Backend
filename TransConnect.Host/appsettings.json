{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TransConnect.Host",
    "Audience": "TransConnect.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 3
  },
  "Google": {
    "ClientId": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Provider": "File",
    "FileDropPath": "",
    "From": {
      "Address": "noreply@example.invalid",
      "DisplayName": "TransConnect"
    },
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "User": "",
      "Password": "",
      "UseStartTls": true
    },
    "Worker": {
      "PollSeconds": 15,
      "BatchSize": 20,
      "MaxAttempts": 5,
      "BackoffBaseSeconds": 30,
      "BackoffMaxSeconds": 3600,
      "StuckAfterMinutes": 10
    },
    "Branding": {
      "AppName": "TransConnect",
      "PrimaryColor": "#0F62FE",
      "LogoUrl": "",
      "CompanyName": "OpenArt",
      "CompanyAddress": "",
      "SupportEmail": "",
      "WebsiteUrl": ""
    }
  },
  "Verification": {
    "CodeLength": 6,
    "ExpiryMinutes": 10,
    "MaxAttempts": 5,
    "MaxRequestsPerHour": 3
  }
}
